# AI Workspace environment template.
# Copy to `.env` (Docker, `next start`) or `.env.local` (`npm run dev`). Never commit the copy.
# Every variable is optional and commented out. API keys are optional too: by default users bring their own keys in the UI.
# Server keys here are used only when the UI leaves a vendor's key empty. An empty value (`NAME=`) counts as unset.
# Schema: src/server/env.server.ts. "shape: URL" means zod `z.url()`: an absolute URL with scheme, or startup fails.
# NEXT_PUBLIC_* values are inlined at build time: set them before `npm run build` or as Docker build args, not at container start.


# ---------------------------------------------------------------------------
# Build and runtime
# ---------------------------------------------------------------------------

# Build output mode (next.config.ts): standalone server bundle, or a static export into dist/.
# default: unset (regular `next build` output in .next/)
# values: standalone | static
# AI_WORKSPACE_BUILD=

# Force strict AIX response parsing in production: throw on unknown vendor API values instead of warning.
# default: unset (strict in development, tolerant in production)
# values: true
# AIX_STRICT_PARSING=

# Public origin of this deployment, for absolute og:image, og:url and canonical tags. Build-time.
# default: unset (those tags are omitted)
# shape: URL, e.g. https://chat.example.com
# NEXT_PUBLIC_SITE_URL=

# Base URL of an App News API for in-app announcements and changelog. Build-time.
# default: unset (feed disabled, its surfaces hidden)
# shape: URL, e.g. https://host/api/app/v1
# NEXT_PUBLIC_SPOTLIGHT_FEED_URL=

# Message of the day: dismissible banner at the top of the app; supports {{app_build_pkgver}}, {{app_build_time}} (docs/customizations.md). Build-time.
# default: unset (no banner)
# NEXT_PUBLIC_MOTD=

# PlantUML server used to render UML diagrams. Build-time.
# default: https://www.plantuml.com/plantuml/svg/
# shape: URL
# NEXT_PUBLIC_PLANTUML_SERVER_URL=


# ---------------------------------------------------------------------------
# Deployment
# ---------------------------------------------------------------------------

# Authentication: off unless one provider below is fully set. Then Postgres (both URLs above) is required.
# See docs/deploy-authentication.md.
# AUTH_SECRET=                  # 32+ chars: openssl rand -base64 32
# AUTH_URL=                     # public https origin, e.g. https://ai.example.com

# Generic OIDC (Pocket ID, Authentik, Keycloak, ...). Callback: ${AUTH_URL}/api/auth/callback/oidc
# Pocket ID: also register ${AUTH_URL}/signin as a logout callback URL.
# AUTH_OIDC_ISSUER=
# AUTH_OIDC_CLIENT_ID=
# AUTH_OIDC_CLIENT_SECRET=
# AUTH_OIDC_NAME=               # button label, default "Pocket ID"

# Google. Callback: ${AUTH_URL}/api/auth/callback/google. Requires AUTH_ALLOWED_EMAILS.
# AUTH_GOOGLE_CLIENT_ID=
# AUTH_GOOGLE_CLIENT_SECRET=

# GitHub. Callback: ${AUTH_URL}/api/auth/callback/github. Requires AUTH_ALLOWED_EMAILS.
# AUTH_GITHUB_CLIENT_ID=
# AUTH_GITHUB_CLIENT_SECRET=

# Microsoft Entra ID. Callback: ${AUTH_URL}/api/auth/callback/microsoft
# AUTH_MICROSOFT_CLIENT_ID=
# AUTH_MICROSOFT_CLIENT_SECRET=
# AUTH_MICROSOFT_TENANT_ID=     # one concrete tenant id; common, organizations, consumers are rejected

# Who may sign in: addresses and @domains, comma-separated. Recommended with OIDC too.
# AUTH_ALLOWED_EMAILS=
# Who is admin (Ollama pull and delete): addresses, comma-separated.
# AUTH_ADMIN_EMAILS=

# PostHog project key; turns on client analytics, error tracking and server exception capture. Build-time.
# default: unset (PostHog off)
# NEXT_PUBLIC_POSTHOG_KEY=

# PostHog ingest host; assets and UI hosts derive from it. Build-time.
# default: https://us.i.posthog.com (EU cloud: https://eu.i.posthog.com, or a self-hosted origin)
# shape: URL
# NEXT_PUBLIC_POSTHOG_HOST=

# PostHog personal API key for source-map upload during `next build`; needs POSTHOG_ENV_ID too. Build-time only.
# POSTHOG_API_KEY=

# PostHog environment (project) id for source-map upload; needs POSTHOG_API_KEY too. Build-time only.
# POSTHOG_ENV_ID=

# Google Analytics 4 measurement id (docs/deploy-analytics.md). Build-time.
# default: unset (GA4 off)
# NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# Postgres pooled connection URL for the shared-link store (runtime, through `@prisma/adapter-pg`). Link sharing turns on only when both Postgres URLs are set (docs/deploy-database.md).
# POSTGRES_PRISMA_URL=

# Postgres direct connection URL (the Prisma CLI through prisma.config.ts: db push, studio); needs POSTGRES_PRISMA_URL too.
# POSTGRES_URL_NON_POOLING=


# ---------------------------------------------------------------------------
# LLM vendor keys (alphabetical by vendor)
# ---------------------------------------------------------------------------

# Alibaba Cloud Model Studio (OpenAI-compatible) API key.
# ALIBABA_API_KEY=
# Alibaba host override.
# default: https://dashscope-intl.aliyuncs.com/compatible-mode
# shape: URL
# ALIBABA_API_HOST=

# Anthropic API key.
# ANTHROPIC_API_KEY=
# Anthropic host override, for proxies or gateways.
# default: api.anthropic.com
# shape: URL
# ANTHROPIC_API_HOST=

# AWS Bedrock long-term API key (ABSK...); takes priority over IAM credentials. Short-term keys work for inference, not model listing.
# BEDROCK_BEARER_TOKEN=
# AWS Bedrock IAM access key id; needs BEDROCK_SECRET_ACCESS_KEY.
# BEDROCK_ACCESS_KEY_ID=
# AWS Bedrock IAM secret access key; needs BEDROCK_ACCESS_KEY_ID.
# BEDROCK_SECRET_ACCESS_KEY=
# AWS session token for temporary (STS) IAM credentials.
# BEDROCK_SESSION_TOKEN=
# AWS region for Bedrock; the server value wins over the client's.
# default: us-east-1
# BEDROCK_REGION=

# Azure OpenAI API key (docs/config-azure-openai.md); needs AZURE_OPENAI_API_ENDPOINT.
# AZURE_OPENAI_API_KEY=
# Azure OpenAI endpoint, host only without a path; needs AZURE_OPENAI_API_KEY.
# shape: URL, e.g. https://my-resource.openai.azure.com
# AZURE_OPENAI_API_ENDPOINT=
# Disable the Azure v1 (next-gen) API used for Responses-style models.
# default: unset (v1 enabled); only the exact value `true` disables it
# values: true
# AZURE_OPENAI_DISABLE_V1=
# Azure API version for traditional deployment-based endpoints.
# default: 2025-04-01-preview
# AZURE_OPENAI_API_VERSION=
# Azure API version for the deployments listing endpoint.
# default: 2023-03-15-preview
# AZURE_DEPLOYMENTS_API_VERSION=

# Cerebras API key.
# CEREBRAS_API_KEY=

# DeepSeek API key.
# DEEPSEEK_API_KEY=

# Google Gemini API key.
# GEMINI_API_KEY=

# Groq API key.
# GROQ_API_KEY=

# LocalAI API key, if the server requires one.
# LOCALAI_API_KEY=
# LocalAI server URL; setting it also enables the LocalAI vendor server-side.
# default: http://127.0.0.1:8080
# shape: URL
# LOCALAI_API_HOST=

# Meta AI (Meta Model API) key.
# METAAI_API_KEY=
# Meta AI host override.
# default: https://api.meta.ai
# shape: URL
# METAAI_API_HOST=

# Mistral API key.
# MISTRAL_API_KEY=

# Modular (MAX) API key.
# MODULAR_API_KEY=

# Moonshot AI (Kimi) API key.
# MOONSHOT_API_KEY=

# NVIDIA NIM API key (nvapi-...), for build.nvidia.com.
# NVIDIANIM_API_KEY=
# NVIDIA NIM host override, e.g. a self-hosted NIM or vLLM endpoint (docs/config-nvidianim.md).
# default: https://integrate.api.nvidia.com
# shape: URL
# NVIDIANIM_API_HOST=

# Ollama server URL; setting it enables the Ollama vendor server-side (docs/config-local-ollama.md).
# default: http://127.0.0.1:11434
# shape: URL
# OLLAMA_API_HOST=

# OpenAI API key.
# OPENAI_API_KEY=
# OpenAI host override, e.g. a Cloudflare AI Gateway.
# default: api.openai.com
# shape: URL
# OPENAI_API_HOST=
# OpenAI organization id, sent as the OpenAI-Organization header.
# OPENAI_API_ORG_ID=

# OpenRouter API key (docs/config-openrouter.md).
# OPENROUTER_API_KEY=

# Perplexity API key.
# PERPLEXITY_API_KEY=

# Sakana AI API key.
# SAKANA_API_KEY=
# Sakana AI host override.
# default: https://api.sakana.ai
# shape: URL
# SAKANA_API_HOST=

# Together AI API key.
# TOGETHERAI_API_KEY=

# xAI API key.
# XAI_API_KEY=


# ---------------------------------------------------------------------------
# Speech, images and other services
# ---------------------------------------------------------------------------
# STT and image generation have no server variables: they reuse the LLM vendor keys above or keys set in the UI.
# OpenAI, Gemini and LocalAI TTS also reuse their LLM keys.

# ElevenLabs API key. Only sets the hasVoiceElevenLabs capability flag, which no client code reads yet: synthesis uses the key entered in the UI.
# ELEVENLABS_API_KEY=

# Google Programmable Search: Google Cloud API key; search is enabled server-side only with GOOGLE_CSE_ID too.
# GOOGLE_CLOUD_API_KEY=
# Google Programmable Search engine id (cx); needs GOOGLE_CLOUD_API_KEY.
# GOOGLE_CSE_ID=

# Browse: Puppeteer-compatible WebSocket endpoint, e.g. browserless (docs/config-feature-browse.md).
# shape: URL, e.g. ws://browserless:3000
# PUPPETEER_WSS_ENDPOINT=

# Google Drive Picker: Google OAuth client id (docs/config-feature-google-drive.md). Build-time.
# NEXT_PUBLIC_GOOGLE_DRIVE_CLIENT_ID=


# ---------------------------------------------------------------------------
# Developer and tools-only
# ---------------------------------------------------------------------------

# Disable React strict mode (any non-empty value).
# NO_STRICT_MODE=1
# Build into this directory instead of .next/ or dist/, to run builds side by side.
# AGI_DIST_DIR=
# Run @next/bundle-analyzer on build and open its report (any non-empty value).
# ANALYZE_BUNDLE=1
# Silence server-side fetcher error logs (any non-empty value).
# SUPPRESS_FETCHER_LOGS=1
# Skip the live Cerebras model listing and use the editorial list.
# values: 1
# LLMS_CEREBRAS_SKIP_LIVE=1
# Break into the debugger on DEV/error/critical logs in development builds. Build-time.
# values: true
# NEXT_PUBLIC_DEBUG_BREAKS=

# listModels.test.ts (run with NODE_ENV=development) also reads the vendor keys above under the same names:
# ALIBABA, ANTHROPIC, CEREBRAS, DEEPSEEK, GEMINI, GROQ, METAAI, MISTRAL, MODULAR, MOONSHOT, NVIDIANIM, OPENAI, OPENROUTER, TOGETHERAI, XAI.
# Test-only Ollama, LM Studio and LocalAI hosts; each test is skipped when its variable is unset.
# AIWORKSPACE_TEST_OLLAMA_HOST=
# AIWORKSPACE_TEST_LMSTUDIO_HOST=
# AIWORKSPACE_TEST_LOCALAI_HOST=
# Test-only Bedrock credentials (standard AWS names, unlike the app's BEDROCK_*).
# AWS_BEARER_TOKEN_BEDROCK=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# default: us-east-1
# AWS_REGION=
# Test-only keys for vendors with no app server variable.
# COHERE_API_KEY=
# ZAI_API_KEY=

# tools/develop/aix-gemini-antigravity-probe: agent to probe (also reads GEMINI_API_KEY).
# PROBE_AGENT=
# tools/develop/aix-protocol-lab/stub-preload.cjs: extra module specifiers to stub, comma-separated substrings.
# STUB_MODULES=
# tools/develop/aix-protocol-lab and nvidianim-catalog-sync read the ANTHROPIC, OPENAI, METAAI, GEMINI and NVIDIANIM keys
# from the environment, .env.api-keys, .env.local or .env. model-fingerprint reads OPENROUTER_API_KEY; aix-anthropic-eviscerate reads ANTHROPIC_API_KEY.


# ---------------------------------------------------------------------------
# Set by the build or the platform, do not set by hand
# ---------------------------------------------------------------------------
# next.config.ts writes these. NEXT_PUBLIC_BUILD_HASH is an input only for git-less builds (Docker: --build-arg);
# otherwise it comes from GITHUB_SHA, VERCEL_GIT_COMMIT_SHA or git. NEXT_PUBLIC_DEPLOYMENT_TYPE keeps a preset value (the Dockerfile sets `docker`).
# NEXT_PUBLIC_BUILD_HASH=
# NEXT_PUBLIC_BUILD_PKGVER=
# NEXT_PUBLIC_BUILD_TIMESTAMP=
# NEXT_PUBLIC_DEPLOYMENT_TYPE=
# Internal counter next.config.ts uses to log once per build.
# __AGI_CONFIG_PASS=
# Node and Next.js.
# NODE_ENV=
# PORT=
# CI (GitHub Actions) and Vercel; CI and VERCEL only make tools/develop/gen-devtools-workspace skip its output.
# CI=
# GITHUB_SHA=
# VERCEL=
# VERCEL_ENV=
# VERCEL_URL=
# VERCEL_GIT_COMMIT_SHA=
# NEXT_PUBLIC_VERCEL_TARGET_ENV=
