# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules

# next.js
/.next/
/.next-*/
/dist/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*

# local env files
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo

# other
.idea/
.vscode/

# Ignore temporary CC files
/tmpclaude*

# Chrome DevTools workspace binding (per-worktree)
/public/.well-known/appspecific/com.chrome.devtools.json

# Generated service worker (built on some branch lines)
/public/sw.js
/public/sw.js.map

/private/
.codegraph/
.remember/
docs/superpowers/

# per-user Claude Code settings
.claude/settings.local.json

# written by next (build, dev, typegen); its import path follows distDir, so it is regenerated, not tracked
next-env.d.ts

# Prisma client, generated by the postinstall (prisma generate)
/src/server/prisma/generated/
