/tmpclaude*

# Chrome DevTools workspace binding (per-worktree)
/public/.well-known/appspecific/com.chrome.devtools.json

# Generated service worker (built on some branch lines)
/public/sw.js
/public/sw.js.map

private/
.codegraph/
.remember/

# per-user Claude Code settings
.claude/settings.local.json
