{
  "permissions": {
    "allow": [
      "Bash(cat:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(ls:*)",
      "Bash(tree:*)",
      "Bash(git branch:*)",
      "Bash(git describe:*)",
      "Bash(git grep:*)",
      "Bash(git log:*)",
      "Bash(git ls-tree:*)",
      "Bash(git show:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(eslint:*)",
      "Bash(npx eslint:*)",
      "Bash(npx tsc:*)",
      "Bash(tsc:*)",
      "Bash(npm run tscheck)",
      "Bash(npm run lint)",
      "Bash(npm test)",
      "Bash(node tools/develop/gen-llms-defs/generate-llms-defs.mjs:*)",
      "Bash(actionlint:*)",
      "WebSearch",
      "mcp__ide__getDiagnostics"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(cat .env*)",
      "Bash(head .env*)",
      "Bash(tail .env*)",
      "Read(./.env*)",
      "Read(./.env.api-keys)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-bash.sh",
            "onFailure": "block",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/lint-edited.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
