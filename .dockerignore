*

!app/
!pages/
!public/
!src/

# gitignored dev artifacts under the allowed dirs: the DevTools workspace file carries the dev machine path, sw.js is branch-line output
public/.well-known/
public/sw.js*
# pdf.js and Tesseract runtime files: prebuild copies them from node_modules inside the image
public/workers/pdf.worker.min.mjs
public/pdfjs/
public/tesseract/
src/**/*.test-fixtures/
# never imported by the build: vendor API spec snapshots and the one test file
src/modules/aix/server/dispatch/wiretypes/_upstream/
src/**/*.test.ts
# generated by the postinstall inside the image; a stale local copy must never enter the context
src/server/prisma/generated/

# build identity: just the sha-bearing git metadata (KBs), never the object store - see next.config.ts
!.git/HEAD
!.git/refs/
!.git/packed-refs

!eslint.config.mjs
!tools/develop/gen-llms-defs/
!tools/develop/browser-assets/
!middleware_BASIC_AUTH.ts
!middleware.ts
!next.config.ts
!prisma.config.ts
!package*.json
!tsconfig.json

!LICENSE
