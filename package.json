{
  "name": "ai-workspace",
  "version": "2026.10.12.2",
  "description": "Self-hosted, local-first, multi-model AI workspace",
  "license": "MIT",
  "private": true,
  "author": "Jason Matherly",
  "homepage": "https://github.com/jrmatherly/ai-workspace",
  "repository": "https://github.com/jrmatherly/ai-workspace",
  "bugs": "https://github.com/jrmatherly/ai-workspace/issues",
  "scripts": {
    "predev": "node tools/develop/browser-assets/copy-browser-assets.mjs && node tools/develop/gen-devtools-workspace/generate-devtools-workspace.mjs && node tools/develop/gen-llms-defs/generate-llms-defs.mjs",
    "predev-debug": "npm run predev",
    "dev": "next dev --webpack",
    "dev-debug": "cross-env NODE_OPTIONS='--inspect' next dev --webpack",
    "predev-https": "npm run predev",
    "dev-https": "next dev --webpack --experimental-https",
    "prebuild": "node tools/develop/browser-assets/copy-browser-assets.mjs && node tools/develop/gen-llms-defs/generate-llms-defs.mjs",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "lint:md": "markdownlint-cli2",
    "pretscheck": "npm install && next typegen",
    "tscheck": "tsc --noEmit --pretty && tsc --noEmit --pretty -p tools/tsconfig.json",
    "pretest": "node tools/develop/browser-assets/copy-browser-assets.mjs",
    "test": "cross-env NODE_ENV=development tsx --test \"src/**/*.test.ts\"",
    "postinstall": "prisma generate --no-hints",
    "gen:icon-sprites": "node tools/develop/gen-icon-sprites/generate-llm-sprites.ts",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "vercel:env:pull": "npx vercel env pull .env.development.local",
    "sharp:win32_x64": "npm install --os=win32 --cpu=x64 sharp"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "1.7.14",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/server": "^11.11.0",
    "@emotion/styled": "^11.14.1",
    "@googleworkspace/drive-picker-react": "^0.2.0",
    "@mui/icons-material": "7.3.11",
    "@mui/joy": "5.0.0-beta.52",
    "@next/bundle-analyzer": "16.4.3",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@tanstack/react-query": "5.105.0",
    "@tanstack/react-virtual": "^3.14.24",
    "@trpc/client": "11.22.1",
    "@trpc/next": "11.22.1",
    "@trpc/react-query": "11.22.1",
    "@trpc/server": "11.22.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "aws4fetch": "^1.0.20",
    "better-auth": "1.7.14",
    "browser-fs-access": "^0.38.0",
    "cheerio": "^1.1.2",
    "csv-stringify": "6.9.0",
    "dexie": "4.4.7",
    "dexie-react-hooks": "4.4.0",
    "diff": "^9.0.0",
    "eventemitter3": "^5.0.4",
    "idb-keyval": "^6.2.6",
    "mammoth": "1.13.0",
    "nanoid": "^6.0.2",
    "next": "16.4.3",
    "nprogress": "^0.2.0",
    "pdfjs-dist": "6.4.299",
    "posthog-js": "1.442.1",
    "posthog-node": "5.60.1",
    "prisma": "7.10.1",
    "prismjs": "^1.30.0",
    "puppeteer-core": "25.16.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "7.91.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "4.15.1",
    "react-timeago": "^8.3.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-mark-highlight": "^0.1.1",
    "remark-math": "^6.0.0",
    "sharp": "0.35.5",
    "superjson": "^2.2.6",
    "tesseract.js": "^7.0.0",
    "tiktoken": "^1.0.22",
    "turndown": "^7.2.4",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@posthog/nextjs-config": "1.12.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@types/node": "26.6.6",
    "@types/nprogress": "^0.2.3",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.3.0",
    "@types/react-csv": "^1.1.10",
    "@types/react-dom": "^19.3.0",
    "@types/turndown": "^5.0.6",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "cross-env": "^10.1.0",
    "eslint": "^10.13.0",
    "eslint-config-next": "16.4.3",
    "eslint-plugin-compat": "^7.0.2",
    "markdownlint-cli2": "0.24.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "overrides": {
    "katex": "^0.19.0",
    "smol-toml": "^1.9.0",
    "deepmerge-ts": "^8",
    "mysql2": "^3.23.1",
    "encoding-sniffer": "^1.0.2",
    "mammoth": {
      "argparse": "^2.0.1"
    },
    "eslint-plugin-react": {
      "eslint": "$eslint"
    },
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    },
    "eslint-plugin-import": {
      "eslint": "$eslint"
    }
  },
  "engines": {
    "node": "^26.0.0 || ^24.0.0 || ^22.13.0"
  },
  "browserslist": {
    "production": [
      "chrome >= 125",
      "edge >= 125",
      "firefox >= 128",
      "safari >= 18",
      "ios_saf >= 18",
      "and_chr >= 125",
      "samsung >= 27",
      "not dead"
    ],
    "development": [
      "last 2 chrome versions",
      "last 2 firefox versions",
      "last 2 safari versions"
    ]
  },
  "allowScripts": {
    "@prisma/engines@7.10.0": true,
    "core-js@3.50.0": true,
    "fsevents@2.3.3": true,
    "sharp@0.33.5": true,
    "sharp@0.35.4": true,
    "prisma@7.10.0": true,
    "tesseract.js@7.0.0": true,
    "unrs-resolver@1.12.2": true,
    "@posthog/cli@0.16.2": true,
    "@posthog/cli@0.18.10": true,
    "esbuild@0.28.2": true
  }
}
